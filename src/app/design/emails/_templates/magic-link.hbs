<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{subject}}</title>
    <style>
      @media only screen and (max-width:480px) {
        .em-pad { padding-left:16px !important; padding-right:16px !important; }
        .em-title { font-size:22px !important; }
        .em-cta { display:block !important; width:100% !important; text-align:center !important; box-sizing:border-box !important; }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background-color:#ffffff;">
    <!-- Preheader (hidden preview text) -->
    <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
      Your magic expires in {{expiresInMinutes}} minutes.
    </div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%; table-layout:fixed; background-color:#ffffff;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="550" style="width:550px; max-width:100%; background-color:#fafafa; border:1px solid #e4e7ec; border-radius:12px; overflow:hidden;">
            <!-- Header / Brand -->
            <tr>
              <td class="em-pad" style="padding:28px 24px 0 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;">
                  <tr>
                    <td style="vertical-align:middle;">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td style="vertical-align:middle; padding-right:8px;">
                            <img src="{{logoUrl}}" width="32" height="32" alt="{{appName}}" style="display:block;" />
                          </td>
                          <td style="vertical-align:middle; font-family: Helvetica, Arial, sans-serif; font-size:18px; font-weight:700; color:#101828;">
                            {{appName}}
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td align="right" style="vertical-align:middle; width:100%;">
                      <table role="presentation" align="right" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="right" style="vertical-align:middle; white-space:nowrap; font-family: Helvetica, Arial, sans-serif; font-size:12px; color:#98a2b3;">
                            <a href="https://{{domain}}" target="_blank" style="color:#98a2b3; text-decoration:none;">{{domain}}</a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!-- Title -->
            <tr>
              <td class="em-pad em-title" style="padding:20px 24px 0 24px; font-family: Helvetica, Arial, sans-serif; font-size:28px; font-weight:700; line-height:1.3; color:#101828;">
                Sign in through Magic link
              </td>
            </tr>
            <!-- Body -->
            <tr>
              <td class="em-pad" style="padding:20px 24px 0 24px; font-family: Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#101828;">
                Login as{{#if recipientEmail}} <span style="font-weight:600;">{{recipientEmail}}</span>{{/if}}. No password required.<br />
                <span style="font-size:13px; color:#667085;">This link expires in <strong style="color:#475467;">{{expiresInMinutes}} minutes</strong> and can only be used once.</span>
              </td>
            </tr>
            <!-- CTA -->
            <tr>
              <td align="left" class="em-pad" style="padding:24px 24px 0 24px;">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{magicLinkUrl}}" style="height:44px;v-text-anchor:middle;width:200px;" arcsize="12%" strokecolor="#16a34a" fillcolor="#16a34a">
                <center style="color:#ffffff;font-family:Helvetica, Arial, sans-serif;font-size:14px;font-weight:600;">Sign in to {{appName}}</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-- -->
                <a href="{{magicLinkUrl}}" target="_blank" class="em-cta" style="display:inline-block; padding:12px 28px; background-color:#16a34a; color:#ffffff; font-family: Helvetica, Arial, sans-serif; font-size:14px; font-weight:600; line-height:1; text-decoration:none; border-radius:8px; mso-hide:all;">
                  Sign in to {{appName}}
                </a>
                <!--<![endif]-->
              </td>
            </tr>
            <!-- Fallback link -->
            <tr>
              <td class="em-pad" style="padding:20px 24px 0 24px; font-family: Helvetica, Arial, sans-serif; font-size:12px; line-height:1.6; color:#98a2b3;">
                If the button doesn’t work, copy and paste this link into your browser:
              </td>
            </tr>
            <tr>
              <td class="em-pad" style="padding:8px 24px 0 24px;">
                <div style="padding:10px 12px; background-color:#f9fafb; border:1px solid #e4e7ec; border-radius:8px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size:11px; line-height:1.5; color:#667085; word-break:break-all;">
                  {{magicLinkUrl}}
                </div>
              </td>
            </tr>
            <!-- Security note -->
            <tr>
              <td class="em-pad" style="padding:20px 24px 0 24px; font-family: Helvetica, Arial, sans-serif; font-size:12px; line-height:1.6; color:#667085;">
                If you didn’t request this email, you can safely ignore it.
              </td>
            </tr>
            <!-- Divider -->
            <tr>
              <td class="em-pad" style="padding:24px 24px 0 24px;">
                <hr style="border:none; border-top:1px dashed #e4e7ec; margin:0;" />
              </td>
            </tr>
            <!-- Footer -->
            <tr>
              <td class="em-pad" style="padding:16px 24px 28px 24px; font-family: Helvetica, Arial, sans-serif; font-size:14px; line-height:1.6; color:#98a2b3;">
                Need help? Feel free to contact us at <a href="mailto:{{supportEmail}}" style="color:#667085; text-decoration:underline;">{{supportEmail}}</a><br />
                <span style="color:#b2b8c2;">This is an automated message, please don’t reply.</span>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
